# ─────────────────────────────────────────────────────────────────────────────
# Variables del backend en producción (grupo de entorno de Render).
#
# PLANTILLA SIN VALORES. Los valores reales viven únicamente en el panel de
# Render, que es la fuente de verdad: no se copian a ningún archivo del repo.
#
# Este archivo existe porque .env.example mezcla lo de desarrollo con lo de
# producción, y esa mezcla ya causó que FRONTEND_URL quedara sin configurar en
# Render — con el resultado de que los correos de verificación y de recuperación
# de contraseña salían apuntando a http://localhost:5173.
# ─────────────────────────────────────────────────────────────────────────────


# ── OBLIGATORIAS ─────────────────────────────────────────────────────────────

# Cadena de conexión de Supabase — pooler de TRANSACCIONES (puerto 6543), con
# `?pgbouncer=true`. Es la correcta para la app: reparte cada transacción entre
# pocas conexiones reales, que es lo que permite operar dentro de los límites del
# plan gratuito. El parámetro le dice a Prisma que desactive los prepared
# statements, que en modo transacción no sobreviven entre consultas.
DATABASE_URL=

# Conexión que usan SOLO las migraciones — session pooler (puerto 5432), sin
# `pgbouncer=true`. Mismo host y credenciales que DATABASE_URL, distinto puerto.
#
# Hace falta porque `prisma migrate` toma un advisory lock que vive en la sesión,
# y en el pooler de transacciones esa sesión vuelve al pool apenas termina la
# transacción: el lock se pierde y la migración se cuelga hasta el timeout.
#
# Con esta variable, Prisma elige sola la conexión correcta para cada cosa. Sin
# ella, cualquier comando `migrate` falla con P1012 (`prisma generate` no la
# necesita, así que el build no se ve afectado).
DIRECT_URL=

# Secreto de firma de los JWT. Distinto al de desarrollo: si se comparte, un
# token emitido en local sirve para entrar a producción.
#
# OJO: de este valor se deriva también la clave AES con la que se cifra el RUT.
# Rotarlo invalida las sesiones abiertas (esperable) y además deja ilegibles los
# RUT ya guardados, que hay que volver a cargar.
JWT_SECRET=

# URL pública del frontend en Vercel, SIN barra final.
#
# auth.service.ts concatena `${FRONTEND_URL}/verify-email?token=...`, así que una
# barra de más produce una ruta con doble barra. Si esta variable falta, el
# código cae al default http://localhost:5173 y los enlaces de los correos llegan
# rotos sin que nada falle de forma visible.
FRONTEND_URL=

# Secreto compartido con el entorno de desarrollo para validar el webhook de
# réplica. Producción es quien RECIBE la réplica, así que lo necesita para
# rechazar los envíos que no vengan del origen esperado.
WEBHOOK_SECRET=


# ── CORREO (SMTP) ────────────────────────────────────────────────────────────
# Sin esto no salen: verificación de correo, recuperación de contraseña, avisos
# de seguridad, resumen mensual, ni el respaldo por correo de las notificaciones.
# Los envíos están envueltos en try/catch, así que su ausencia no voltea ninguna
# operación: simplemente no llega nada y queda registrado en el log.
#
# MAIL_FROM no debe llevar comillas envolventes. En un archivo .env dotenv las
# quita al leer, pero el panel de Render guarda el texto literal, y con comillas
# nodemailer arma un remitente inválido. El valor correcto allí es del estilo:
#     Pfinance <no-reply@ejemplo.com>
MAIL_HOST=
MAIL_PORT=
MAIL_SECURE=
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=


# ── WEB PUSH (VAPID) ─────────────────────────────────────────────────────────
# Generar un par PROPIO de producción con:  npx web-push generate-vapid-keys
#
# Si faltan, la app sigue funcionando: el backend arranca con un warning, nadie
# puede suscribirse (GET /api/vapid-public-key responde 500) y los avisos caen al
# respaldo por correo. El único síntoma visible es que el botón "Activar
# notificaciones" del perfil da error al tocarlo.
#
# Cambiar el par más adelante invalida todas las suscripciones existentes y
# obliga a cada usuario a volver a activarlas.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Contacto del emisor que exige el estándar VAPID: un mailto: o una URL https:.
# web-push valida el formato al arrancar; si no cuadra, deja push deshabilitado
# exactamente igual que si la variable faltara.
VAPID_SUBJECT=


# ─────────────────────────────────────────────────────────────────────────────
# NO configurar en producción
# ─────────────────────────────────────────────────────────────────────────────
#
# PORT
#   Render la inyecta sola en todo servicio web. main.ts hace
#   `process.env.PORT ?? 3000`, así que definirla a mano solo puede romperlo.
#
# SYNC_TO_REMOTE
#   Activa la réplica de escrituras locales hacia producción. prisma.service.ts
#   compara `=== 'true'`, así que ausente equivale a apagado. Producción es el
#   destino de esa réplica, nunca el origen: ponerla acá haría que producción se
#   replicara a sí misma.
#
# PROD_API_URL
#   Destino de esa misma réplica. Solo tiene sentido en el entorno de desarrollo.
