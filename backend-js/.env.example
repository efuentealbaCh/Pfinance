DATABASE_URL=
JWT_SECRET=
PORT=3000

# URL pública del frontend (sin barra final). Se usa para armar links de correos
# transaccionales, ej. el link de verificación de email: ${FRONTEND_URL}/verify-email?token=...
FRONTEND_URL=http://localhost:5173

# WEBHOOK SYNC CONFIG
SYNC_TO_REMOTE=
PROD_API_URL=
WEBHOOK_SECRET=

# MAIL (SMTP genérico - ej. Brevo, pero cualquier proveedor SMTP funciona)
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="Pfinance <no-reply@ejemplo.com>"
