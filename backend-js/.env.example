DATABASE_URL=
JWT_SECRET=
PORT=3000

# URL pública del frontend (sin barra final). Se usa para armar links de correos
# transaccionales, ej. el link de verificación de email: ${FRONTEND_URL}/verify-email?token=...
FRONTEND_URL=http://localhost:5173

# WEBHOOK SYNC CONFIG
SYNC_TO_REMOTE=
PROD_API_URL=
WEBHOOK_SECRET=

# MAIL (SMTP genérico - ej. Brevo, pero cualquier proveedor SMTP funciona)
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="Pfinance <no-reply@ejemplo.com>"

# WEB PUSH (VAPID)
# Generar un par propio con: npx web-push generate-vapid-keys
# (o webpush.generateVAPIDKeys() desde Node). La pública se sirve en
# GET /api/vapid-public-key para que el PWA pueda suscribirse.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contacto del emisor exigido por el estándar VAPID: debe ser un mailto: o una URL https:
VAPID_SUBJECT=mailto:no-reply@ejemplo.com
